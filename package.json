{
  "name": "discord-tickets-bot",
  "version": "1.0.0",
  "description": "Discord ticket bot with a dashboard API (TypeScript, discord.js)",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "deploy-commands": "ts-node src/commands/deployCommands.ts",
    "build": "tsc -p tsconfig.json",
    "dev:bot": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:dashboard": "cd src/dashboard && npm run dev",
    "start:bot": "node ./dist/index.js",
    "start:dashboard": "cd src/dashboard && npm run start"
  },
  "keywords": [
    "discord",
    "tickets",
    "discord.js",
    "tickets-bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^8.7.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "discord-html-transcripts": "^3.2.0",
    "discord.js": "^14.14.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
